{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Shore Control Reliance Lab design tokens. Same values as tokens.css; the CSS custom property for each token is given in $extensions.css.",
  "color": {
    "$type": "color",
    "bg": { "$value": { "day": "#eef3f4", "night": "#081014" }, "$description": "Page background", "$extensions": { "css": "--bg" } },
    "panel": { "$value": { "day": "#ffffff", "night": "#0e1b21" }, "$description": "Card and panel surface", "$extensions": { "css": "--panel" } },
    "panel2": { "$value": { "day": "#f3f7f8", "night": "#12232b" }, "$description": "Inset surface: inputs, secondary buttons, table highlight", "$extensions": { "css": "--panel2" } },
    "line": { "$value": { "day": "#c9d9de", "night": "#21404b" }, "$description": "Borders and dividers", "$extensions": { "css": "--line" } },
    "fg": { "$value": { "day": "#0f2228", "night": "#d6e6ea" }, "$description": "Primary text", "$extensions": { "css": "--fg" } },
    "muted": { "$value": { "day": "#4f6b73", "night": "#86a2ab" }, "$description": "Secondary text, labels", "$extensions": { "css": "--muted" } },
    "own": { "$value": { "day": "#0b7f97", "night": "#59c9e0" }, "$description": "Own vessel; also focus ring, links and data-open marks", "$extensions": { "css": "--own" } },
    "target": { "$value": { "day": "#6a4fd1", "night": "#b9a6ff" }, "$description": "Target vessel", "$extensions": { "css": "--target" } },
    "ai": { "$value": { "day": "#a95f00", "night": "#f3b23f" }, "$description": "AI advisory, under-reliance, warnings, in-progress status", "$extensions": { "css": "--ai" } },
    "aiSoft": { "$value": { "day": "#fbe9cf", "night": "#3a2c10" }, "$description": "Soft background for ai-coloured pills and highlighted rows", "$extensions": { "css": "--aiSoft" } },
    "good": { "$value": { "day": "#1f8a52", "night": "#5cc28a" }, "$description": "Feedback only: appropriate reliance, saved, finished", "$extensions": { "css": "--good" } },
    "goodSoft": { "$value": { "day": "#dff1e6", "night": "#123323" }, "$extensions": { "css": "--goodSoft" } },
    "bad": { "$value": { "day": "#c43d32", "night": "#ef6a5e" }, "$description": "Feedback only: over-reliance, safety limit, timeout", "$extensions": { "css": "--bad" } },
    "badSoft": { "$value": { "day": "#f8e0dd", "night": "#3a1714" }, "$extensions": { "css": "--badSoft" } },
    "plot": { "$value": { "day": "#f7fbfc", "night": "#061015" }, "$description": "Radar plot background", "$extensions": { "css": "--plot" } },
    "ring": { "$value": { "day": "#c6d8de", "night": "#183641" }, "$description": "Range rings and axes on the plot", "$extensions": { "css": "--ring" } },
    "ringLabel": { "$value": { "day": "#6b8890", "night": "#4f7380" }, "$extensions": { "css": "--ringLabel" } },
    "accent": { "$value": { "day": "#0d8784", "night": "#4fc1b4" }, "$description": "Primary action buttons. Deliberately not green: good/bad stay for feedback", "$extensions": { "css": "--accent" } },
    "accentText": { "$value": { "day": "#ffffff", "night": "#07171a" }, "$extensions": { "css": "--accentText" } }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Barlow Condensed", "Arial Narrow", "sans-serif"], "$description": "Headings, big numbers, condensed labels", "$extensions": { "css": "--font-display" } },
    "body": { "$value": ["IBM Plex Sans", "system-ui", "sans-serif"], "$extensions": { "css": "--font-body" } },
    "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Sensor values, times, codes, plot labels", "$extensions": { "css": "--font-mono" } }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": { "$value": "11px", "$extensions": { "css": "--fs-xs" } },
    "s": { "$value": "12px", "$extensions": { "css": "--fs-s" } },
    "m": { "$value": "13px", "$extensions": { "css": "--fs-m" } },
    "base": { "$value": "14px", "$extensions": { "css": "--fs-base" } },
    "l": { "$value": "15px", "$extensions": { "css": "--fs-l" } },
    "xl": { "$value": "18px", "$extensions": { "css": "--fs-xl" } },
    "2xl": { "$value": "20px", "$extensions": { "css": "--fs-2xl" } },
    "3xl": { "$value": "24px", "$extensions": { "css": "--fs-3xl" } },
    "4xl": { "$value": "26px", "$extensions": { "css": "--fs-4xl" } },
    "5xl": { "$value": "28px", "$extensions": { "css": "--fs-5xl" } },
    "6xl": { "$value": "32px", "$extensions": { "css": "--fs-6xl" } },
    "7xl": { "$value": "40px", "$extensions": { "css": "--fs-7xl" } },
    "8xl": { "$value": "48px", "$extensions": { "css": "--fs-8xl" } }
  },
  "lineHeight": {
    "$type": "number",
    "tight": { "$value": 1.05, "$extensions": { "css": "--lh-tight" } },
    "snug": { "$value": 1.3, "$extensions": { "css": "--lh-snug" } },
    "base": { "$value": 1.45, "$extensions": { "css": "--lh-base" } }
  },
  "letterSpacing": {
    "$type": "dimension",
    "display": { "$value": "0.02em", "$extensions": { "css": "--ls-display" } },
    "wide": { "$value": "0.04em", "$extensions": { "css": "--ls-wide" } },
    "capsS": { "$value": "0.06em", "$description": "Small uppercase labels", "$extensions": { "css": "--ls-caps-s" } },
    "caps": { "$value": "0.08em", "$description": "Eyebrows and section labels", "$extensions": { "css": "--ls-caps" } }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "2px", "$extensions": { "css": "--sp-0" } },
    "1": { "$value": "4px", "$extensions": { "css": "--sp-1" } },
    "2": { "$value": "6px", "$extensions": { "css": "--sp-2" } },
    "3": { "$value": "8px", "$extensions": { "css": "--sp-3" } },
    "4": { "$value": "10px", "$extensions": { "css": "--sp-4" } },
    "5": { "$value": "12px", "$extensions": { "css": "--sp-5" } },
    "6": { "$value": "14px", "$extensions": { "css": "--sp-6" } },
    "7": { "$value": "16px", "$extensions": { "css": "--sp-7" } },
    "8": { "$value": "20px", "$extensions": { "css": "--sp-8" } },
    "9": { "$value": "24px", "$extensions": { "css": "--sp-9" } },
    "10": { "$value": "32px", "$extensions": { "css": "--sp-10" } },
    "11": { "$value": "40px", "$extensions": { "css": "--sp-11" } },
    "12": { "$value": "48px", "$extensions": { "css": "--sp-12" } },
    "13": { "$value": "64px", "$extensions": { "css": "--sp-13" } },
    "14": { "$value": "80px", "$extensions": { "css": "--sp-14" } }
  },
  "radius": {
    "$type": "dimension",
    "2xs": { "$value": "2px", "$extensions": { "css": "--r-2xs" } },
    "xs": { "$value": "3px", "$extensions": { "css": "--r-xs" } },
    "s": { "$value": "6px", "$extensions": { "css": "--r-s" } },
    "m": { "$value": "8px", "$extensions": { "css": "--r-m" } },
    "l": { "$value": "10px", "$extensions": { "css": "--r-l" } },
    "xl": { "$value": "12px", "$extensions": { "css": "--r-xl" } },
    "pill": { "$value": "999px", "$extensions": { "css": "--r-pill" } }
  },
  "border": {
    "default": { "$type": "border", "$value": { "width": "1px", "style": "solid", "color": "{color.line}" }, "$extensions": { "css": "--border" } }
  },
  "shadow": {
    "fab": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "2px", "blur": "10px", "spread": "0", "color": "rgba(0,0,0,0.25)" }, "$extensions": { "css": "--shadow-fab" } }
  },
  "duration": {
    "$type": "duration",
    "default": { "$value": "200ms", "$description": "Transitions; disabled under prefers-reduced-motion", "$extensions": { "css": "--dur" } }
  },
  "layout": {
    "$type": "dimension",
    "contentMax": { "$value": "1220px", "$extensions": { "css": "--content-max" } },
    "pagePad": { "$value": "16px", "$extensions": { "css": "--page-pad" } },
    "breakpointStack": { "$value": "880px", "$description": "Below this the workspace and dashboard stack into one column" },
    "breakpointShort": { "$value": "820px", "$description": "Below this viewport height the start console tightens" }
  },
  "component": {
    "$type": "dimension",
    "padBtn": { "$value": "9px 14px", "$extensions": { "css": "--pad-btn" } },
    "padBtnSmall": { "$value": "5px 10px", "$extensions": { "css": "--pad-btn-small" } },
    "padSeg": { "$value": "7px 12px", "$extensions": { "css": "--pad-seg" } },
    "padChip": { "$value": "3px 9px", "$extensions": { "css": "--pad-chip" } },
    "padInput": { "$value": "6px 8px", "$extensions": { "css": "--pad-input" } },
    "padCell": { "$value": "5px 6px", "$extensions": { "css": "--pad-cell" } },
    "sizeFab": { "$value": "38px", "$extensions": { "css": "--size-fab" } },
    "sizeStep": { "$value": "34px", "$extensions": { "css": "--size-step" } },
    "touchTarget": { "$value": "44px", "$description": "Minimum height of claims, helm buttons and alternative actions" }
  }
}
